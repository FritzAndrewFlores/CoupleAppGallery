rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function hasOwnUserDoc() {
      return exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function myUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isCurrentPartner(otherUid) {
      return isSignedIn()
        && otherUid is string
        && otherUid != ''
        && otherUid != request.auth.uid
        && hasOwnUserDoc()
        && myUserData().get('partnerId', '') == otherUid;
    }

    function effectiveOwner(data) {
      return data.get('ownerId', '') != ''
        ? data.ownerId
        : (data.participants.size() > 0 ? data.participants[0] : '');
    }

    function validSharedItemCreate(data) {
      return isSignedIn()
        && data.get('ownerId', '') == request.auth.uid
        && data.participants is list
        && request.auth.uid in data.participants
        && (
          data.participants.size() == 1 ||
          (
            data.participants.size() == 2 &&
            isCurrentPartner(data.participants.removeAll([request.auth.uid])[0])
          )
        );
    }

    function validSharedItemUpdate() {
      return isSignedIn()
        && request.auth.uid in resource.data.participants
        && (
          // 1. Metadata edit without altering participants
          (
            request.resource.data.participants == resource.data.participants &&
            request.resource.data.get('ownerId', '') in [
              resource.data.get('ownerId', ''),
              effectiveOwner(resource.data)
            ]
          ) ||
          // 2. Creator toggling sharing with their currently linked partner
          (
            effectiveOwner(resource.data) == request.auth.uid &&
            request.resource.data.get('ownerId', '') == request.auth.uid &&
            request.resource.data.participants is list &&
            request.auth.uid in request.resource.data.participants &&
            (
              request.resource.data.participants.size() == 1 ||
              (
                request.resource.data.participants.size() == 2 &&
                isCurrentPartner(request.resource.data.participants.removeAll([request.auth.uid])[0])
              )
            )
          ) ||
          // 3. Unlink revocation by non-creator participant: return item solely to its creator
          (
            effectiveOwner(resource.data) != request.auth.uid &&
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['participants', 'ownerId']) &&
            request.resource.data.ownerId == effectiveOwner(resource.data) &&
            request.resource.data.participants == [effectiveOwner(resource.data)]
          )
        );
    }

    // -------------------------------------------------------------------------
    // USERS — No listing; read only own doc or currently linked partner's doc.
    // -------------------------------------------------------------------------
    match /users/{userId} {
      allow get: if isSignedIn() && (
        request.auth.uid == userId ||
        resource.data.get('partnerId', '') == request.auth.uid
      );
      allow list: if false;

      allow create: if isSignedIn()
        && request.auth.uid == userId
        && request.resource.data.get('partnerId', '') == '';

      allow update: if isSignedIn() && (
        // Case 1: Updating own user document
        (
          request.auth.uid == userId && (
            // Normal profile / status / FCM token / inviteCode update (partnerId unchanged)
            request.resource.data.get('partnerId', '') == resource.data.get('partnerId', '') ||
            // Bidirectional unlink initiated by self
            (
              request.resource.data.get('partnerId', '') == '' &&
              resource.data.get('partnerId', '') != '' &&
              getAfter(/databases/$(database)/documents/users/$(resource.data.partnerId)).data.get('partnerId', '') == ''
            ) ||
            // Bidirectional link initiated by self (redeeming partner's invite code)
            (
              resource.data.get('partnerId', '') == '' &&
              request.resource.data.get('partnerId', '') != '' &&
              request.resource.data.get('partnerId', '') != userId &&
              getAfter(/databases/$(database)/documents/users/$(request.resource.data.partnerId)).data.get('partnerId', '') == userId
            )
          )
        ) ||
        // Case 2: Linked partner syncing shared couple theme fields only or anniversary date
        (
          resource.data.get('partnerId', '') == request.auth.uid &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'themeId', 'themePrimary', 'themeSecondary', 'themeBg', 'themeText', 'themeWallpaper', 'anniversaryDate'
          ])
        ) ||
        // Case 3: Linked partner performing atomic bidirectional unlink
        (
          resource.data.get('partnerId', '') == request.auth.uid &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['partnerId']) &&
          request.resource.data.get('partnerId', '') == '' &&
          getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('partnerId', '') == ''
        ) ||
        // Case 4: Incoming partner redeeming this user's active, non-expired 6-character invite code
        (
          request.auth.uid != userId &&
          resource.data.get('partnerId', '') == '' &&
          resource.data.get('inviteCode', '') != '' &&
          exists(/databases/$(database)/documents/invite_codes/$(resource.data.inviteCode)) &&
          get(/databases/$(database)/documents/invite_codes/$(resource.data.inviteCode)).data.ownerUid == userId &&
          get(/databases/$(database)/documents/invite_codes/$(resource.data.inviteCode)).data.get('createdAt', 0) > request.time.toMillis() - 604800000 &&
          !existsAfter(/databases/$(database)/documents/invite_codes/$(resource.data.inviteCode)) &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['partnerId', 'inviteCode']) &&
          request.resource.data.partnerId == request.auth.uid &&
          request.resource.data.inviteCode == '' &&
          getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('partnerId', '') == userId
        )
      );

      allow delete: if false;
    }

    // -------------------------------------------------------------------------
    // INVITE CODES — Exact 6-char lookup only; never listable; 7-day TTL; one-time use.
    // -------------------------------------------------------------------------
    match /invite_codes/{code} {
      allow get: if isSignedIn();
      allow list: if false;

      allow create: if isSignedIn()
        && code.size() == 6
        && request.resource.data.code == code
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.createdAt is int
        && request.resource.data.createdAt <= request.time.toMillis() + 3600000;

      allow update: if false;

      allow delete: if isSignedIn() && (
        resource == null ||
        resource.data.ownerUid == request.auth.uid ||
        (
          getAfter(/databases/$(database)/documents/users/$(resource.data.ownerUid)).data.get('partnerId', '') == request.auth.uid &&
          getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('partnerId', '') == resource.data.ownerUid
        )
      );
    }

    // -------------------------------------------------------------------------
    // FOLDERS (ALBUMS) & SUBCOLLECTIONS
    // -------------------------------------------------------------------------
    match /folders/{folderId} {
      allow read: if isSignedIn() && request.auth.uid in resource.data.participants;
      allow create: if validSharedItemCreate(request.resource.data);
      allow update: if validSharedItemUpdate();
      allow delete: if isSignedIn() && request.auth.uid in resource.data.participants;

      function isParentFolderMember() {
        return isSignedIn()
          && exists(/databases/$(database)/documents/folders/$(folderId))
          && request.auth.uid in get(/databases/$(database)/documents/folders/$(folderId)).data.get('participants', []);
      }

      match /images/{imageId} {
        allow read, write: if isParentFolderMember();
      }
      match /journal/{entryId} {
        allow read, write: if isParentFolderMember();
      }
      match /plans/{planId} {
        allow read, write: if isParentFolderMember();
      }
    }

    // -------------------------------------------------------------------------
    // SPECIAL DAYS & SUBCOLLECTIONS
    // -------------------------------------------------------------------------
    match /special_days/{eventId} {
      allow read: if isSignedIn() && request.auth.uid in resource.data.participants;
      allow create: if validSharedItemCreate(request.resource.data);
      allow update: if validSharedItemUpdate();
      allow delete: if isSignedIn() && request.auth.uid in resource.data.participants;

      function isParentEventMember() {
        return isSignedIn()
          && exists(/databases/$(database)/documents/special_days/$(eventId))
          && request.auth.uid in get(/databases/$(database)/documents/special_days/$(eventId)).data.get('participants', []);
      }

      match /plans/{planId} {
        allow read, write: if isParentEventMember();
      }
      match /images/{imageId} {
        allow read, write: if isParentEventMember();
      }
    }

    // -------------------------------------------------------------------------
    // CHATS — Scoped to conversation members only
    // -------------------------------------------------------------------------
    match /chats/{messageId} {
      allow read: if isSignedIn() && (
        resource.data.get('senderId', '') == request.auth.uid ||
        resource.data.get('receiverId', '') == request.auth.uid ||
        (resource.data.get('chatId', '') is string && request.auth.uid in resource.data.chatId.split('_'))
      );

      allow create: if isSignedIn()
        && request.resource.data.senderId == request.auth.uid
        && isCurrentPartner(request.resource.data.receiverId)
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 4000
        && request.resource.data.chatId == (
          request.auth.uid < request.resource.data.receiverId
            ? request.auth.uid + '_' + request.resource.data.receiverId
            : request.resource.data.receiverId + '_' + request.auth.uid
        );

      allow update: if isSignedIn() && (
        (
          resource.data.receiverId == request.auth.uid &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isRead']) &&
          request.resource.data.isRead == true
        ) ||
        (
          (resource.data.senderId == request.auth.uid || resource.data.receiverId == request.auth.uid) &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reaction']) &&
          request.resource.data.reaction is string &&
          request.resource.data.reaction.size() <= 32
        )
      );

      allow delete: if false;
    }

    // -------------------------------------------------------------------------
    // REQUESTS (PARTNER WISHES)
    // -------------------------------------------------------------------------
    match /requests/{requestId} {
      allow read: if isSignedIn() && (
        resource.data.receiverId == request.auth.uid ||
        resource.data.requesterId == request.auth.uid
      );

      allow create: if isSignedIn()
        && request.resource.data.requesterId == request.auth.uid
        && isCurrentPartner(request.resource.data.receiverId);

      allow update: if false;

      allow delete: if isSignedIn() && (
        resource.data.receiverId == request.auth.uid ||
        resource.data.requesterId == request.auth.uid
      );
    }

    // -------------------------------------------------------------------------
    // NOTIFICATIONS — Recipient reads/updates/deletes; linked partner creates
    // -------------------------------------------------------------------------
    match /notifications/{notificationId} {
      allow read: if isSignedIn() && resource.data.to == request.auth.uid;

      allow create: if isSignedIn()
        && request.resource.data.from == request.auth.uid
        && request.resource.data.to != request.auth.uid
        && isCurrentPartner(request.resource.data.to)
        && request.resource.data.read == false
        && request.resource.data.title is string
        && request.resource.data.title.size() <= 200
        && request.resource.data.body is string
        && request.resource.data.body.size() <= 1000;

      allow update: if isSignedIn()
        && resource.data.to == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']);

      allow delete: if isSignedIn() && resource.data.to == request.auth.uid;
    }
  }
}
